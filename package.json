{
	"name": "pi-tern",
	"version": "1.1.11",
	"description": "Tern integration for the pi coding agent: TSP handshake, native Mermaid diagrams, WKWebView browser automation, pane capture and a session mirror.",
	"license": "MIT",
	"author": "Mayank Batra",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ghost-9/pi-tern.git"
	},
	"homepage": "https://github.com/Ghost-9/pi-tern#readme",
	"bugs": {
		"url": "https://github.com/Ghost-9/pi-tern/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"tern",
		"tsp",
		"mermaid",
		"terminal",
		"stencil",
		"extension",
		"developer-tools"
	],
	"files": [
		"index.ts",
		"lib",
		"docs",
		"examples",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"scripts",
		"spikes",
		"native",
		"profile",
		"test",
		"tsconfig.json"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --experimental-strip-types --test test/protocol.test.ts test/native.test.ts test/features.test.ts test/refs.test.ts test/bridge-luau.test.ts test/native-sink.test.ts test/agent-setup.test.ts test/version.test.ts test/handshake.test.ts test/fleet-prune.test.ts test/package.test.ts",
		"test:live": "node --experimental-strip-types --test test/live.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint index.ts lib test",
		"coverage": "node --experimental-strip-types --test --experimental-test-coverage test/protocol.test.ts",
		"bench": "node --experimental-strip-types scripts/bench.ts",
		"gate": "bash scripts/gate.sh",
		"verify": "node --experimental-strip-types scripts/verify.ts"
	},
	"engines": {
		"node": ">=22.6.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@types/node": "^22.10.0",
		"oxlint": "^1.87.0",
		"typebox": "1.3.27",
		"typescript": "^5.7.0"
	}
}
