{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"lib": ["ES2022"],
		"types": ["node"]
	},
	"include": ["index.ts", "lib/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"]
}
